<Window x:Class="TaskTracker.AddTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskTracker"
        mc:Ignorable="d"
        Title="Добавление задачи" Height="547" Width="450"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20,10,20,19">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderText" Text="Новая задача"
                   FontSize="20" FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Название задачи *" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="TitleTextBox" Height="30"
                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                     Padding="5,0" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Описание" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="DescriptionTextBox" Height="80"
                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap" AcceptsReturn="True"
                     Padding="5" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,15">
            <TextBlock Text="Приоритет" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ComboBox x:Name="PriorityComboBox" Height="30"
                      ItemsSource="{Binding Source={x:Static local:EnumHelper.Priorities}}"
                      SelectedItem="{Binding Priority}"
                      SelectedIndex="0"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,15">
            <TextBlock Text="Срок выполнения" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <DatePicker x:Name="DeadlinePicker" Height="30"
                        SelectedDate="{Binding Deadline}"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,0,0,15">
            <TextBlock Text="Категория" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ComboBox x:Name="CategoryComboBox" Height="30"
                      ItemsSource="{Binding Source={x:Static local:EnumHelper.Categories}}"
                      SelectedItem="{Binding Category}"
                      SelectedIndex="0"/>
        </StackPanel>

        <StackPanel Grid.Row="7" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="SaveButton" Content="Сохранить"
                    Width="100" Height="35" Margin="0,0,10,0"
                    IsDefault="True" Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" Content="Отмена"
                    Width="100" Height="35"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>